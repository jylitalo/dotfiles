conky.config = {
    -- Window & Position Settings
    alignment = 'top_right',
    gap_x = 30,
    gap_y = 200,
    minimum_width = 360,
    maximum_width = 360,
    own_window = true,
    own_window_type = 'override',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 210,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    
    -- Font & Colors
    use_xft = true,
    font = 'Monospace:size=10',
    xftalpha = 1.0,
    update_interval = 5.0,
    total_run_times = 0,
    double_buffer = true,
    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = false,

    -- Theme Palette
    default_color = '#ECEFF4',        -- Text color (Nord Snow Storm)
    color1 = '#88C0D0',               -- Mod / Accent color (Nord Frost)
    color2 = '#EBCB8B',               -- Category Headers (Nord Nord Frost Yellow)
    color3 = '#D8DEE9',               -- Key descriptions
    
    -- Margins
    border_inner_margin = 15,
    border_outer_margin = 0,
};

conky.text = [[
${color2}${font Monospace:bold:size=11}SWAY KEYBINDINGS${font}${color}
${color1}Mod Key:${color} ${color3}Super / Logo (Mod4)${color}
${hr 1}

${color2}SYSTEM / GENERAL${color}
${color1}Mod + Enter${color}        ${color3}Terminal (alacritty)${color}
${color1}Mod + d${color}            ${color3}App Launcher (wmenu)${color}
${color1}Mod + Shift + q${color}    ${color3}Kill Window${color}
${color1}Mod + Shift + c${color}    ${color3}Reload Sway Config${color}
${color1}Mod + Shift + e${color}    ${color3}Exit Sway${color}
${color1}Print${color}              ${color3}Screenshot (grim)${color}

${color2}NAVIGATION (Vim / Arrows)${color}
${color1}Mod + h/j/k/l${color}      ${color3}Focus Left/Down/Up/Right${color}
${color1}Mod + Shift + h..l${color} ${color3}Move Window Left/Down/Up/Right${color}

${color2}LAYOUT & WINDOWS${color}
${color1}Mod + b / Mod + v${color}  ${color3}Split Horiz / Vert${color}
${color1}Mod + f${color}            ${color3}Toggle Fullscreen${color}
${color1}Mod + s / w / e${color}    ${color3}Stack / Tabbed / Split Mode${color}
${color1}Mod + Shift + Space${color}${color3}Toggle Floating Mode${color}
${color1}Mod + Space${color}        ${color3}Switch Tiling/Floating Focus${color}
${color1}Mod + a${color}            ${color3}Focus Parent Container${color}

${color2}WORKSPACES${color}
${color1}Mod + [0-9]${color}        ${color3}Switch Workspace 1-10${color}
${color1}Mod + Shift + [0-9]${color}${color3}Move Window to Workspace 1-10${color}

${color2}SCRATCHPAD${color}
${color1}Mod + Shift + -${color}    ${color3}Move Window to Scratchpad${color}
${color1}Mod + -${color}            ${color3}Show / Cycle Scratchpad${color}

${color2}MODES${color}
${color1}Mod + r${color}            ${color3}Resize Mode${color}
  ${color3}├─ h/j/k/l${color}        ${color1}Shrink/Grow Width & Height${color}
  ${color3}└─ Esc / Enter${color}    ${color1}Exit Resize Mode${color}
]];
